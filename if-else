 # Positive or Negative Number

num = 5

if num > 0:
    print("Positive Number")
else:
    print("Negative Number")

# Zero or Not Zero

num = 0

if num == 0:
    print("Number is Zero")
else:
    print("Number is Not Zero")

# Adult or Minor

age = 20

